# Copy this file to .env and adjust values as needed
MONGODB_URI=mongodb://127.0.0.1:27017/blood_donation_db
PORT=1320
JWT_SECRET=change-this-secret

# Optional: SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: Email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Blood Donation <no-reply@example.com>"
